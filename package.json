{
  "name": "dsh-drop-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Turns a dropped non-image file into an @file reference by writing it to the session's drop directory",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/dsh-typert-registry": "*",
    "puppeteer-core": "*"
  }
}
